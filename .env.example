# llm-core Konfiguration
# Kopiere diese Datei nach .env und fülle die benötigten Werte aus.

# Aktives Backend: ollama | anthropic | openrouter | mistral | openai
LLM_BACKEND=anthropic

# Modell-ID (leer lassen für Backend-spezifische Defaults)
LLM_MODEL=claude-sonnet-4-6

# Optionale Parameter
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=4096

# Privacy Mode: erzwingt Ollama (kein Cloud-Call)
# LLM_PRIVACY_MODE=false

# ---------------------------------------------------------------------------
# API Keys — nur setzen was gebraucht wird
# ---------------------------------------------------------------------------

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (Aggregator — Zugang zu 200+ Modellen)
OPENROUTER_API_KEY=sk-or-...

# Mistral direkt (EU)
MISTRAL_API_KEY=...

# OpenAI direkt
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Ollama (lokal)
# ---------------------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Datenpfade
# ---------------------------------------------------------------------------
# Wo die Cost-Tracking SQLite DB gespeichert wird
# LLM_CORE_DATA_DIR=~/.llm_core
