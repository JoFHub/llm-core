# Vorlage: nach server/.env kopieren und Werte eintragen (nicht in Git). Keine echten Werte in diese Datei!
# Adresse (sslip.io: Punkte der Server-IP durch Bindestriche ersetzen) — nur für die Prüfung in
# aktualisieren.sh; Caddy liest KOSTEN_HOST aus probatio/server/.env.
KOSTEN_HOST=kosten.203-0-113-10.sslip.io

# OpenRouter-Provisioning-Key: alle Keys, Guthaben, Verwaltung (Limits, Keys anlegen/sperren)
OPENROUTER_PROVISIONING_KEY=

# Optional: Anthropic-Admin-Key (sk-ant-admin…) für die Kosten der Organisation
# ANTHROPIC_ADMIN_KEY=
