# Vorlage: nach server/.env kopieren und Werte eintragen (nicht in Git). Keine echten Werte in diese Datei!
# Adresse „Ratio“ (eigene Domain, seit 2026-11-20) — nur für die Prüfung in aktualisieren.sh; Caddy liest
# KOSTEN_HOST aus probatio/server/.env.
KOSTEN_HOST=ratio.example.de

# OpenRouter-Provisioning-Key: alle Keys, Guthaben, Verwaltung (Limits, Keys anlegen/sperren)
OPENROUTER_PROVISIONING_KEY=

# Optional: fester Euro-Kurs (Euro je Dollar) statt des EZB-Kurses von frankfurter.dev
# LLM_CORE_EUR_KURS=0,92
